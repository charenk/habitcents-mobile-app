{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "internal": {
      "distribution": "store",
      "channel": "internal",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_DEV_MENU": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_DEV_MENU": "0"
      }
    }
  },
  "submit": {
    "internal": {
      "ios": {
        "ascAppId": "6791025610"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6791025610"
      }
    }
  }
}
